# Public base URL of the deployment. Used for canonical URLs, Open Graph
# image resolution and the sitemap. Vercel sets this per environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB connection string. Optional — with it unset the contact form still
# validates and confirms, and logs the enquiry instead of storing it, so the
# project runs from a fresh clone with no database.
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_URI=

# Database name. Defaults to "voltaris" when unset.
MONGODB_DB=voltaris
